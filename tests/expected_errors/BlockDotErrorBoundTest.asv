% -----------------------------
% Test BlockDot Relative Error
% -----------------------------

clear; clc;
rng(500) % Initialise RNG seed so results are reproducible

vecLength = 32;          % BlockDot operates on one block
numTrials = 1000;        % Number of random tests
maxVal = 1e4;

elFormats = {'E4M3', 'E5M2'};

removeInputError = 0; % Set to 0 to keep binary64 inputs

% -----------------------------
% MX SETTINGS
% -----------------------------

MX.accumulator_opts.format = 's';
MX.output_opts.format = 's';
MX.k = vecLength;

% -----------------------------
% PREALLOCATE
% -----------------------------

errors = zeros(numTrials, numel(elFormats));

% -----------------------------
% GENERATE TEST DATA
% -----------------------------

A = maxVal * (2*rand(vecLength, numTrials) - 1);
B = maxVal * (2*rand(vecLength, numTrials) - 1);

% -----------------------------
% LOOP OVER ELEMENT FORMATS
% -----------------------------

for elIdx = 1:numel(elFormats)

    MX.element_opts.format = elFormats{elIdx};

    for trial = 1:numTrials

        % Extract vectors
        a = A(:, trial);
        b = B(:, trial);

        % ---------------------------------
        % OPTIONAL: REMOVE INPUT ERROR
        % ---------------------------------

        if removeInputError

            MXa = MXconvert(a, MX);
            a = MXconvert_inv(MXa, vecLength);

            MXb = MXconvert(b, MX);
            b = MXconvert_inv(MXb, vecLength);

        end

        % ---------------------------------
        % CONVERT TO MX BLOCKS
        % ---------------------------------

        AMX = MXconvert(a, MX);
        BMX = MXconvert(b, MX);

        % BlockDot expects ONE block
        % so use the first cell

        result = BlockDot(AMX{1}, BMX{1}, MX);

        % ---------------------------------
        % REFERENCE RESULT
        % ---------------------------------

        trueVal = dot(a, b);

        % ---------------------------------
        % RELATIVE ERROR
        % ---------------------------------

        if abs(trueVal) < 1e-10
            errors(trial, elIdx) = NaN;
        elseif trueVal ~= 0
            errors(trial, elIdx) = abs(result - trueVal) / abs(trueVal);
        else
            errors(trial, elIdx) = NaN;
        end

        
end

end

% -----------------------------
% PLOT RESULTS
% -----------------------------

figure;
hold on;

for elIdx = 1:numel(elFormats)

    semilogy(1:numTrials, errors(:, elIdx), ...
        'DisplayName', elFormats{elIdx});

end

xlabel('Trial');
ylabel('Relative Error');
title('BlockDot Relative Error');
legend show;
grid on;